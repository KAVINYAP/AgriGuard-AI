   ========================================================= */

/**
 * Perform lightweight validation of the
 * application's static data.
 *
 * This intentionally does not throw errors.
 * It only reports malformed records so that
 * one bad data entry does not break the UI.
 */
function validateAgriGuardData() {

    const problems = [];


    /* Crops */

    Object.entries(CROP_DATA).forEach(
        ([cropId, crop]) => {

            if (!crop.name) {
                problems.push(
                    `Crop ${cropId} is missing a name.`
                );
            }

            if (!Array.isArray(crop.commonDiseases)) {
                problems.push(
                    `Crop ${cropId} has invalid disease list.`
                );
            }

        }
    );


    /* Diseases */

    Object.entries(DISEASE_DATA).forEach(
        ([diseaseId, disease]) => {

            if (!disease.name) {
                problems.push(
                    `Disease ${diseaseId} is missing a name.`
                );
            }

            if (!CROP_DATA[disease.crop]) {
                problems.push(
                    `Disease ${diseaseId} references unknown crop ${disease.crop}.`
                );
            }

        }
    );


    /* Fields */

    FIELD_DATA.forEach(field => {

        if (!field.id) {
            problems.push(
                "A field is missing an ID."
            );
        }

        if (!field.name) {
            problems.push(
                `Field ${field.id || "unknown"} is missing a name.`
            );
        }

        if (!CROP_DATA[field.crop]) {
            problems.push(
                `Field ${field.id} references unknown crop ${field.crop}.`
            );
        }

    });


    if (problems.length > 0) {

        console.warn(
            "AgriGuard data validation warnings:",
            problems
        );

    }

    return problems;

}


