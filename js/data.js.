   ========================================================= */

/**
 * Return all crop records as an array.
 */
function getAllCrops() {

    return Object.values(CROP_DATA);

}


/**
 * Return a crop by ID.
 */
function getCropById(cropId) {

    if (!cropId) {
        return null;
    }

    return CROP_DATA[cropId] || null;

}


/**
 * Return a disease by ID.
 */
function getDiseaseById(diseaseId) {

    if (!diseaseId) {
        return null;
    }

    return DISEASE_DATA[diseaseId] || null;

}


/**
 * Return all diseases associated with a crop.
 */
function getDiseasesForCrop(cropId) {

    const crop = getCropById(cropId);

    if (!crop) {
        return [];
    }

    return crop.commonDiseases
        .map(diseaseId => getDiseaseById(diseaseId))
        .filter(Boolean);

}


/**
 * Return a field by ID.
 */
function getFieldById(fieldId) {

    if (!fieldId) {
        return null;
    }

    return FIELD_DATA.find(
        field => field.id === fieldId
    ) || null;

}


/**
 * Return all fields.
 */
function getAllFields() {

    return [...FIELD_DATA];

}


/**
 * Return all active alerts.
 */
function getActiveAlerts() {

    return ALERT_DATA.filter(
        alert => alert.active
    );

}


/**
 * Return the number of active alerts.
 */
function getActiveAlertCount() {

    return getActiveAlerts().length;

}


/**
 * Find diagnosis history for a field.
 */
function getDiagnosisHistoryForField(fieldId) {

    return DIAGNOSIS_HISTORY.filter(
        item => item.fieldId === fieldId
    );

}


/**
 * Return diagnosis history sorted newest first.
 */
function getDiagnosisHistoryLatestFirst() {

    return [...DIAGNOSIS_HISTORY].sort(
        (a, b) => {

            const dateA =
                new Date(`${a.date}T${a.time}`);

            const dateB =
                new Date(`${b.date}T${b.time}`);

            return dateB - dateA;

        }
    );

}


/**
 * Calculate average field health.
 */
function calculateAverageFieldHealth() {

    if (!FIELD_DATA.length) {
        return 0;
    }

    const total =
        FIELD_DATA.reduce(
            (sum, field) =>
                sum + Number(field.health || 0),
            0
        );

    return Math.round(
        total / FIELD_DATA.length
    );

}


/**
 * Calculate average disease risk.
 */
function calculateAverageFieldRisk() {

    if (!FIELD_DATA.length) {
        return 0;
    }

    const total =
        FIELD_DATA.reduce(
            (sum, field) =>
                sum + Number(field.risk || 0),
            0
        );

    return Math.round(
        total / FIELD_DATA.length
    );

}


/**
 * Get dashboard field summary.
 */
function getDashboardFieldSummary() {

    return FIELD_DATA.map(field => ({

        id: field.id,

        name: field.name,

        crop: field.cropName,

        health: field.health,

        risk: field.risk,

        moisture: field.moisture,

        status: field.status,

        statusType: field.statusType

    }));

}


/**
 * Get dashboard weather forecast.
 */
function getWeatherForecast() {

    return WEATHER_DATA.daily.map(day => ({

        day: day.shortDay,

        condition: day.condition,

        high: day.temperatureHigh,

        low: day.temperatureLow,

        rainfallProbability:
            day.rainfallProbability,

        icon: day.icon

    }));

}


/**
 * Create a diagnosis history record.
 */
function createDiagnosisHistoryRecord(result = {}) {

    return {

        id:
            result.id ||
            `DX-${Date.now()}`,

        date:
            result.date ||
            new Date().toISOString().slice(0, 10),

        time:
            result.time ||
            new Date().toLocaleTimeString(
                "en-IN",
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            ),

        fieldId:
            result.fieldId || null,

        field:
            result.field || "Unknown Field",

        crop:
            result.crop || "Unknown Crop",

        cropId:
            result.cropId || null,

        diseaseId:
            result.diseaseId || null,

        disease:
            result.disease ||
            "No disease detected",

        confidence:
            Number(result.confidence || 0),

        risk:
            result.risk || "Low",

        severity:
            result.severity || "None",

        affectedArea:
            result.affectedArea || "None"

    };

}


