/**
 * Find crop by ID.
 */
function getCropById(cropId) {

    return CROPS.find(
        crop => crop.id === cropId
    ) || null;
}


/**
 * Find disease by ID.
 */
function getDiseaseById(diseaseId) {

    return DISEASES.find(
        disease => disease.id === diseaseId
    ) || null;
}


/**
 * Find field by ID.
 */
function getFieldById(fieldId) {

    return FIELDS.find(
        field => field.id === fieldId
    ) || null;
}


/**
 * Get all diseases for a crop.
 */
function getDiseasesForCrop(cropId) {

    return DISEASES.filter(
        disease => disease.cropId === cropId
    );
}


/**
 * Get alerts for a field.
 */
function getAlertsForField(fieldId) {

    return ALERTS.filter(
        alert => alert.fieldId === fieldId
    );
}


/**
 * Get diagnosis history for a field.
 */
function getDiagnosisHistoryForField(fieldId) {

    return DIAGNOSIS_HISTORY.filter(
        diagnosis => diagnosis.fieldId === fieldId
    );
}


/**
 * Get recommendation for a disease.
 */
function getRecommendationForDisease(diseaseId) {

    return RECOMMENDATIONS[diseaseId] || null;
}


/**
 * Get demo diagnosis.
 */
function getDemoDiagnosis(cropId, diseaseKey) {

    if (
        !DEMO_DIAGNOSIS_RESPONSES[cropId]
    ) {
        return null;
    }

    return (
        DEMO_DIAGNOSIS_RESPONSES[cropId][diseaseKey]
        || DEMO_DIAGNOSIS_RESPONSES[cropId].healthy
    );
}


/* ============================================================
   18. RISK CLASSIFICATION
============================================================ */

function classifyRisk(score) {

    if (score >= 70) {
        return {
            label: "High",
            className: "risk-high"
        };
    }

    if (score >= 40) {
        return {
            label: "Medium",
            className: "risk-medium"
        };
    }

    return {
        label: "Low",
        className: "risk-low"
    };
}


/**
 * Determine crop health category.
 */
function classifyHealth(score) {

    if (score >= 85) {
        return "Healthy";
    }

    if (score >= 70) {
        return "Good";
    }

    if (score >= 50) {
        return "At Risk";
    }

    return "Critical";
}


/* ============================================================
   19. WEATHER RISK HELPERS
============================================================ */

function calculateWeatherRisk(weather) {

    let risk = 0;

    if (weather.humidity >= 80) {
        risk += 30;
    } else if (weather.humidity >= 70) {
        risk += 20;
    } else if (weather.humidity >= 60) {
        risk += 10;
    }

    if (weather.rainfall24h >= 30) {
        risk += 30;
    } else if (weather.rainfall24h >= 15) {
        risk += 20;
    } else if (weather.rainfall24h >= 5) {
        risk += 10;
    }

    if (weather.temperature >= 30) {
        risk += 15;
    } else if (weather.temperature >= 25) {
        risk += 8;
    }

    return Math.min(
        100,
        risk
    );
}


/* ============================================================
   20. SOIL HEALTH HELPERS
============================================================ */

function calculateSoilHealth(soil) {

    let score = 100;

    /*
        pH
    */

    if (
        soil.ph < 5.5 ||
        soil.ph > 7.5
    ) {
        score -= 20;
    }

    /*
        Moisture
    */

    if (
        soil.moisture < 30 ||
        soil.moisture > 80
    ) {
        score -= 20;
    }

    /*
        Nitrogen
    */

    if (
        soil.nitrogen < 35 ||
        soil.nitrogen > 85
    ) {
        score -= 15;
    }

    /*
        Phosphorus
    */

    if (
        soil.phosphorus < 25 ||
        soil.phosphorus > 75
    ) {
        score -= 15;
    }

    /*
        Potassium
    */

    if (
        soil.potassium < 35 ||
        soil.potassium > 90
    ) {
        score -= 15;
    }

    /*
        Organic carbon
    */

    if (
        soil.organicCarbon < 0.4
    ) {
        score -= 15;
    }

    return Math.max(
        0,
        score
    );
}


/* ============================================================
   21. FIELD RISK CALCULATION
============================================================ */

function calculateFieldRisk(field) {

    if (!field) {
        return 0;
    }

    let risk = field.riskScore || 0;

    const weatherRisk =
        calculateWeatherRisk(
            field.weather
        );

    /*
        Combine existing field risk
        with environmental risk.
    */

    risk =
        (risk * 0.65) +
        (weatherRisk * 0.35);

    return Math.round(
        Math.min(
            100,
            risk
        )
    );
}


/* ============================================================
   22. DASHBOARD SUMMARY
============================================================ */

function getDashboardSummary() {

    const totalArea =
        FIELDS.reduce(
            (sum, field) =>
                sum + field.area,
            0
        );

    const averageHealth =
        FIELDS.reduce(
            (sum, field) =>
                sum + field.healthScore,
            0
        ) / FIELDS.length;

    const averageRisk =
        FIELDS.reduce(
            (sum, field) =>
                sum + field.riskScore,
            0
        ) / FIELDS.length;

    return {

        totalArea:
            Number(totalArea.toFixed(1)),

        averageHealth:
            Math.round(averageHealth),

        averageRisk:
            Math.round(averageRisk),

        activeAlerts:
            ALERTS.filter(
                alert =>
                    alert.status === "active"
            ).length,

        monitoredFields:
            FIELDS.length,

        diagnoses:
            DIAGNOSIS_HISTORY.length
    };
}


/* ============================================================
   23. DIAGNOSIS RESULT BUILDER
============================================================ */

function buildDiagnosisResult(
    cropId,
    diseaseKey
) {

    const response =
        getDemoDiagnosis(
            cropId,
            diseaseKey
        );

    if (!response) {
        return null;
    }

    const disease =
        response.diseaseId
            ? getDiseaseById(
                response.diseaseId
            )
            : null;

    const recommendation =
        response.diseaseId
            ? getRecommendationForDisease(
                response.diseaseId
            )
            : null;

    const risk =
        classifyRisk(
            response.riskScore
        );

    return {

        ...response,

        crop:
            getCropById(
                cropId
            ),

        disease,

        risk,

        recommendation,

        timestamp:
            new Date().toLocaleString(
                "en-IN",
                {
                    dateStyle: "medium",
                    timeStyle: "short"
                }
            )
    };
}


